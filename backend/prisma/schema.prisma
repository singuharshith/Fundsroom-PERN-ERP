// Prisma Schema for PERN ERP System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES_USER
}

enum EnquiryStatus {
  NEW
  QUOTED
  WON
  LOST
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum SalesOrderStatus {
  PENDING
  CONFIRMED
  DISPATCHED
  CANCELLED
}

model User {
  id            Int          @id @default(autoincrement())
  name          String
  email         String       @unique
  password_hash String
  role          Role         @default(SALES_USER)
  created_at    DateTime     @default(now())

  enquiries     Enquiry[]
  quotations    Quotation[]
  created_orders SalesOrder[] @relation("OrderCreator")
  confirmed_orders SalesOrder[] @relation("OrderConfirmer")
  dispatches    Dispatch[]

  @@map("users")
}

model Customer {
  id             Int          @id @default(autoincrement())
  company_name   String
  contact_person String
  mobile         String
  email          String
  city           String
  created_at     DateTime     @default(now())

  enquiries      Enquiry[]
  quotations     Quotation[]
  sales_orders   SalesOrder[]

  @@map("customers")
}

model Product {
  id           Int        @id @default(autoincrement())
  product_code String     @unique
  product_name String
  category     String
  unit         String
  base_price   Decimal    @db.Decimal(12, 2)
  created_at   DateTime   @default(now())

  inventory        Inventory?
  enquiry_items    EnquiryItem[]
  quotation_items  QuotationItem[]
  sales_order_items SalesOrderItem[]
  dispatch_items   DispatchItem[]

  @@map("products")
}

model Inventory {
  id                Int      @id @default(autoincrement())
  product_id        Int      @unique
  product           Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  physical_quantity Int      @default(0)
  reserved_quantity Int      @default(0)

  @@map("inventory")
}

model Enquiry {
  id             Int           @id @default(autoincrement())
  enquiry_number String        @unique
  customer_id    Int
  customer       Customer      @relation(fields: [customer_id], references: [id])
  enquiry_date   DateTime      @default(now())
  required_date  DateTime
  notes          String?
  status         EnquiryStatus @default(NEW)
  created_by     Int
  user           User          @relation(fields: [created_by], references: [id])
  created_at     DateTime      @default(now())

  items          EnquiryItem[]
  quotations     Quotation[]

  @@map("enquiries")
}

model EnquiryItem {
  id         Int     @id @default(autoincrement())
  enquiry_id Int
  enquiry    Enquiry @relation(fields: [enquiry_id], references: [id], onDelete: Cascade)
  product_id Int
  product    Product @relation(fields: [product_id], references: [id])
  quantity   Int

  @@map("enquiry_items")
}

model Quotation {
  id               Int             @id @default(autoincrement())
  quotation_number String          @unique
  enquiry_id       Int
  enquiry          Enquiry         @relation(fields: [enquiry_id], references: [id])
  customer_id      Int
  customer         Customer        @relation(fields: [customer_id], references: [id])
  valid_until      DateTime
  status           QuotationStatus @default(DRAFT)
  grand_total      Decimal         @db.Decimal(12, 2)
  created_by       Int
  user             User            @relation(fields: [created_by], references: [id])
  created_at       DateTime        @default(now())

  items            QuotationItem[]
  sales_order      SalesOrder?

  @@map("quotations")
}

model QuotationItem {
  id               Int       @id @default(autoincrement())
  quotation_id     Int
  quotation        Quotation @relation(fields: [quotation_id], references: [id], onDelete: Cascade)
  product_id       Int
  product          Product   @relation(fields: [product_id], references: [id])
  quantity         Int
  unit_price       Decimal   @db.Decimal(12, 2)
  discount_percent Decimal   @db.Decimal(5, 2) @default(0)
  gst_percent      Decimal   @db.Decimal(5, 2) @default(18)
  line_amount      Decimal   @db.Decimal(12, 2)

  @@map("quotation_items")
}

model SalesOrder {
  id           Int              @id @default(autoincrement())
  order_number String           @unique
  customer_id  Int
  customer     Customer         @relation(fields: [customer_id], references: [id])
  quotation_id Int              @unique
  quotation    Quotation        @relation(fields: [quotation_id], references: [id])
  order_date   DateTime         @default(now())
  total_amount Decimal          @db.Decimal(12, 2)
  status       SalesOrderStatus @default(PENDING)
  created_by   Int
  creator      User             @relation("OrderCreator", fields: [created_by], references: [id])
  confirmed_by Int?
  confirmer    User?            @relation("OrderConfirmer", fields: [confirmed_by], references: [id])
  created_at   DateTime         @default(now())

  items        SalesOrderItem[]
  dispatches   Dispatch[]

  @@map("sales_orders")
}

model SalesOrderItem {
  id             Int        @id @default(autoincrement())
  sales_order_id Int
  sales_order    SalesOrder @relation(fields: [sales_order_id], references: [id], onDelete: Cascade)
  product_id     Int
  product        Product    @relation(fields: [product_id], references: [id])
  quantity       Int

  @@map("sales_order_items")
}

model Dispatch {
  id              Int          @id @default(autoincrement())
  dispatch_number String       @unique
  sales_order_id  Int
  sales_order     SalesOrder   @relation(fields: [sales_order_id], references: [id])
  dispatch_date   DateTime     @default(now())
  vehicle_number  String
  driver_name     String
  dispatched_by   Int
  user            User         @relation(fields: [dispatched_by], references: [id])
  created_at      DateTime     @default(now())

  items           DispatchItem[]

  @@map("dispatches")
}

model DispatchItem {
  id          Int      @id @default(autoincrement())
  dispatch_id Int
  dispatch    Dispatch @relation(fields: [dispatch_id], references: [id], onDelete: Cascade)
  product_id  Int
  product     Product  @relation(fields: [product_id], references: [id])
  quantity    Int

  @@map("dispatch_items")
}
